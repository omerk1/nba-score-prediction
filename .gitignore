# Data files (large files should not be in git)
data/raw/*
data/processed/*
*.sqlite
*.db
*.csv
*.parquet

# But keep .gitkeep files
!**/.gitkeep

# Keep ablation logs. outputs/experiments.csv is the old 16-column schema,
# frozen historical snapshot; outputs/experiments_v2.csv (CLAUDE.md's Project
# Rules section) is the live registry going forward, seeded from it via
# scripts/migrate_experiments_schema.py.
!outputs/experiments.csv
!outputs/experiments_v2.csv

# Keep the full per-run feature-importance tables (small, one row per feature)
# so the ablation record has durable evidence of where each run's features
# ranked, same rationale as !outputs/experiments.csv above.
!outputs/full_feature_importance_*.csv

# Keep the market-benchmark cross-run history (scripts/market_benchmark.py) --
# one small row appended per run, same rationale as !outputs/experiments.csv
# above. The per-game join dump (outputs/market_benchmark_games_<tag>.csv) is
# overwritten per run, not a permanent ledger, so it stays gitignored.
!outputs/market_benchmark_summary.csv

# Keep the comeback-dip analysis deliverables (small summary outputs, not raw
# bulk source data -- dip_events.parquet is ~12k summary rows, recovery_matrix.csv
# is a small p x N table), same rationale as !outputs/experiments.csv above.
!data/polymarket_prices/dip_events.parquet
!data/polymarket_prices/recovery_matrix.csv

# Player on/off splits: backfill progress log (one row per API call, durable
# evidence of what was fetched/skipped/empty -- same rationale as
# !outputs/experiments.csv) and the validation sample output, both small.
!outputs/on_off_backfill_log.csv
!outputs/on_off_splits_results.csv

# Dedicated iteration scratch file for the backfill-completion round (step 1
# of on/off-splits' iterative-improvement plan) -- keeps this round's
# baseline-vs-treatment comparison out of the shared outputs/experiments.csv
# (per the coordinator's instruction) while still being durable, committed
# evidence, same rationale as !outputs/experiments.csv above.
!outputs/on_off_splits_iteration_scratch.csv

# Season motivation: validation sample output and iteration scratch file, same
# rationale as the on/off-splits pair above.
!outputs/season_motivation_results.csv
!outputs/season_motivation_iteration_scratch.csv

# CLAUDE.md's "Leaderboards & research sessions" rules: research/autonomous
# sessions log every run to results/sessions/<session_id>.csv before
# promoting the session's best row(s) to outputs/experiments_v2.csv. Session
# CSVs are archived, never deleted -- same rationale as
# !outputs/experiments_v2.csv above.
!results/sessions/*.csv
# Polymarket price-history pipeline: raw API cache (json.gz, needs its own
# rule -- not .csv/.parquet so the blanket rules above don't cover it).
# games.csv/series/*.parquet used to be committed via an exception here (from
# when this was a 5-game test); now that it's scaled to a full season
# (1,417 games, ~26MB and growing every future run), that no longer fits the
# "large files should not be in git" rule at the top of this file, so it's
# local-only now, same as the project's other data (basketball.sqlite,
# nba_api.sqlite, etc.) -- covered by the blanket *.csv/*.parquet rules above.
data/polymarket_prices/raw/*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Model files (too large for git)
catboost_info/
*.pkl
*.joblib
*.h5
*.pt
*.pth

# Logs and outputs
logs/
*.log
outputs/predictions/*
outputs/visualizations/*
outputs/reports/*

# Claude Code settings (local overrides are personal, project settings are shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Generated model artifacts
data/models/training_metadata.json

# API keys and secrets
.env
secrets.json
config.local.yaml

# Temporary files
tmp/
temp/
*.tmp
