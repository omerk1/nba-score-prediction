{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/warn_git_destructive.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; case \"$f\" in *.py) venv/bin/black \"$f\" 2>/dev/null && venv/bin/isort \"$f\" 2>/dev/null ;; esac; } || true"
          },
          {
            "type": "command",
            "command": ".claude/hooks/verify_write.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check_status_log_updated.sh"
          }
        ]
      }
    ]
  }
}
